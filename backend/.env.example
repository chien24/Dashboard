# Cấu hình OCR Dashboard. Chạy từ source: chép thành backend/.env.
# Bản cài (OCRDashboard.exe): lần chạy đầu tự chép thành %LOCALAPPDATA%\OCRDashboard\.env và mở Notepad để điền.
# Sửa xong phải tắt và mở lại OCR Dashboard thì mới có tác dụng.

# --- BẮT BUỘC: tài khoản đăng nhập dashboard ---
AUTH_USER=
AUTH_PASSWORD=
# chuỗi ngẫu nhiên dài để ký cookie phiên (vd: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=

# --- API key OCR: cần ít nhất 1 provider. Thứ tự dùng: Cloudflare -> NVIDIA -> OpenRouter ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
NVIDIA_API_KEY=
OPEN_ROUTER_API_KEY=

# --- Chatbot (Groq) ---
GROQ_API_KEY=

# --- Dữ liệu ---
RETENTION_DAYS=35
TIMEZONE=Asia/Ho_Chi_Minh
OCR_CONCURRENCY=1
OCR_PASSES=2
MAX_UPLOAD_MB=10
# Bỏ trống = thư mục data/ cạnh file .env này (source: backend/data)
# DATABASE_URL=sqlite:///D:/du-lieu/ocr.db
# UPLOAD_DIR=D:/du-lieu/uploads

# tùy chọn: override chuỗi model, cách nhau bằng dấu phẩy
CLOUDFLARE_MODELS=
NVIDIA_MODELS=
OPENROUTER_MODELS=

# --- Bản cài: cổng web (mặc định 8000; đổi thì sửa luôn cổng trong Cloudflare Tunnel), tự mở trình duyệt (1/0) ---
# PORT=8000
# OPEN_BROWSER=1

# --- Log (xem HUONG_DAN_LOG_DB.md) ---
LOG_LEVEL=INFO
LOG_TO_FILE=1
LOG_RETENTION_DAYS=35
LOG_ACCESS=api
# LOG_DIR=   (bỏ trống = data/logs)
