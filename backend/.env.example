GEMINI_API_KEY=
NVIDIA_API_KEY=
OPEN_ROUTER_API_KEY=

DATABASE_URL=sqlite:///./data/ocr.db
UPLOAD_DIR=./data/uploads
RETENTION_DAYS=35
TIMEZONE=Asia/Ho_Chi_Minh
OCR_CONCURRENCY=1
OCR_PASSES=2
MAX_UPLOAD_MB=10

# tùy chọn: override chuỗi model, cách nhau bằng dấu phẩy
GEMINI_MODELS=
NVIDIA_MODELS=
OPENROUTER_MODELS=
GROQ_API_KEY=

# Tài khoản dùng chung để đăng nhập dashboard
AUTH_USER=
AUTH_PASSWORD=
# chuỗi ngẫu nhiên dài để ký cookie phiên (vd: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=

# --- Log (xem HUONG_DAN_LOG_DB.md) ---
LOG_LEVEL=INFO
LOG_TO_FILE=1
LOG_RETENTION_DAYS=35
LOG_ACCESS=api
# LOG_DIR=   (bỏ trống = backend/data/logs)
